pve_endpoint   = "https://CHANGEME_PVE:8006/"
pve_api_token  = "root@pam!tofu=CHANGEME_TOKEN"
pve_node       = "pve"
template_id    = 9000
node01_age_key = "AGE-SECRET-KEY-CHANGEME"

# SSH vers le node PVE (upload des snippets cloud-init).
pve_ssh_username = "root"
# Auth par mot de passe (si tu te connectes en mdp au SSH du Proxmox) :
pve_ssh_password = "CHANGEME_MDP_ROOT_PVE"
# Ou par cle privee (contenu, pas chemin) :
# pve_ssh_private_key = "-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----\n"
# Si ni mdp ni cle => l'agent SSH est utilise.

# Reseau node01 : IP statique (recommande) ou "dhcp".
node01_ip      = "192.168.1.201/24"
node01_gateway = "192.168.1.1"
